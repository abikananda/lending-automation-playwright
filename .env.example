# LenDenClub UI
LENDENCLUB_URL=https://app.lendenclub.com

# Select exactly one lender for this Playwright process.
# Use the lender.external_lender_id value from the backend database.
LENDER_ID=IAKI7TL1UT6K

# Backend
BACKEND_URL=http://localhost:8080
BACKEND_API_KEY=
BACKEND_AUTH_HEADER=X-API-Key
BACKEND_HEALTH_PATH=/actuator/health
LENDER_DATA_PATH=/api/lender/data
LENDER_SESSION_PATH=/api/lender/session
OTP_PATH=/api/fetchOtp
EVALUATION_PATH=/api/borrower/evaluate
NPA_BORROWER_PATH=/api/npa-borrowers

# Runtime
HEADLESS=false
SLOW_MO=100
API_TIMEOUT=30000
UI_TIMEOUT=30000
LENDING_SUCCESS_URL_PATTERN=manual-lending-success

# Optional persistence endpoints
PERSIST_BORROWER_PATH=
PERSIST_EVALUATION_PATH=
PERSIST_INVESTMENT_PATH=
PERSIST_SESSION_PATH=
PERSIST_RESULT_PATH=
